	function m.changecanvas(UIScale, ScrollingFrame, UIListLayout, Plus)
		local function updateCanvas()
			local scale = UIScale and UIScale.Scale or 1
			local size = UIListLayout.AbsoluteContentSize

			if UIListLayout.FillDirection == Enum.FillDirection.Horizontal then
				ScrollingFrame.CanvasSize = UDim2.new(0, size.X / scale + (Plus or 5), 0, 0)
			else
				ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, size.Y / scale + (Plus or 5))
			end
		end

		if UIScale then
			UIScale:GetPropertyChangedSignal("Scale"):Connect(updateCanvas)
		end

		UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
		updateCanvas()
	end
	function m.lak(t, o)
		local a, b, c, d
		local function u(i)
			local dt = i.Position - c
			m.tw({v = o, t = 0.05, s = Enum.EasingStyle.Linear, d = "Out", g = {Position = UDim2.new(d.X.Scale, d.X.Offset + dt.X, d.Y.Scale, d.Y.Offset + dt.Y)}}):Play()
		end
		t.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then a = true c = i.Position d = o.Position; i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then a = false end end) end end)
		t.InputChanged:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then b = i end end)
		UserInputService.InputChanged:Connect(function(i) if i == b and a then u(i) end end)
	end
	function m.getIconData(i)
		local id = Il.Icons[i]
		if id then
			local spriteSheet = Il.Spritesheets[tostring(id.Image)]
			if spriteSheet then
				return {
					Image = spriteSheet,
					ImageRectSize = id.ImageRectSize,
					ImageRectPosition = id.ImageRectPosition,
				}
			end
		end
		if type(i) == 'string' and not i:find('rbxassetid://') then
			return {
				Image = "rbxassetid://".. i,
				ImageRectSize = Vector2.new(0, 0),
				ImageRectPosition = Vector2.new(0, 0),
			}
		elseif type(i) == 'number' then
			return {
				Image = "rbxassetid://".. i,
				ImageRectSize = Vector2.new(0, 0),
				ImageRectPosition = Vector2.new(0, 0),
			}
		else
			return i
		end
	end
	function m.gl(obj, id)
		local dt = m.getIconData(id)
		if typeof(obj) == "Instance" and obj:IsA("GuiObject") and dt then
			obj.Image = dt.Image
			obj.ImageRectSize = dt.ImageRectSize
			obj.ImageRectOffset = dt.ImageRectPosition
		end
		return dt
	end
	function m.jc(c, p)
		local x, y = Mouse.X - c.AbsolutePosition.X, Mouse.Y - c.AbsolutePosition.Y
		if x < 0 or y < 0 or x > c.AbsoluteSize.X or y > c.AbsoluteSize.Y then return end

		local f = m.n("Frame", p)
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.BackgroundTransparency = 0.7
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.new(0, x, 0, y)
		f.Size = UDim2.new(0, 0, 0, 0)
		f.ZIndex = 10

		m.n("UICorner", f).CornerRadius = UDim.new(1, 0)

		local t = m.tw({v = f, t = 1, s = Enum.EasingStyle.Quad, d = "Out", g = {
			Size = UDim2.new(0, c.AbsoluteSize.X * 1.5, 0, c.AbsoluteSize.X * 1.5),
			BackgroundTransparency = 1
		}})
		t.Completed:Once(function() f:Destroy() end)
		t:Play()
	end
